/* ==========================================================================
   MOXIE BRAND PALETTE — LIGHT MODE

   Design rule:
     - Square corners everywhere. Every border-radius is 0.
     - Exception: the search bar is a rounded pill (border-radius: 22px).
     - Also rounded: BackBtn (8px), EventDetailsBtn (8px), source badges
       (9px), search suggestion popup (12px), chat bubbles (16px).

   Brand core
   --------------------------------------------------------------------------
   Blush Beige (bg)        #D8CBC7   window + page background
   Moxie Purple (brand)    #2D1A3E   titles, primary button
   Purple Hover            #47305C   primary button hover
   Blueberry (accent)      #3D4BA8   card top rule, focus rings, RSVP
   Blueberry Hover         #2F3B8A   RSVP button hover

   Surfaces & borders
   --------------------------------------------------------------------------
   Nav / Header Surface    #C1AEA8
   Filter Surface          #CBB9B4
   Card Surface            #F5F0EE
   Input Surface           #FBF8F7
   Input Surface Focus     #FFFFFF
   Border                  #BFAFB3
   Border Soft             #D8DCE3
   Disabled Surface        #E4DAD6

   Text
   --------------------------------------------------------------------------
   Text on Dark            #F5F0EE
   Text Primary            #2D1A3E
   Text Label              #4E3C5C
   Text Muted              #6B5B77
   Text Disabled           #A89AA0

   Interaction
   --------------------------------------------------------------------------
   Selection BG            #2D1A3E
   Selection Text          #F5F0EE
   Recording Red           #C0392B
   ========================================================================== */

/* ── Window & General Layout ───────────────────────────────────── */
QMainWindow {
    background-color: #D8CBC7;
}

#NavBar {
    background-color: #C1AEA8;
    border-bottom: 1px solid rgba(216, 203, 199, 0.15);
    color: #2D1A3E;
    min-height: 60px;
}

#NavLogo {
    color: #F5F0EE;
    font-size: 30px;
    font-weight: bold;
}

#HeroLogo {
    font-size: 60px;
}

#BottomBar {
    background-color: #C1AEA8;
    border-top: 1px solid #BFAFB3;
}

#SloganText {
    font-size: 20px;
    color: #2D1A3E;
}

/* ── Form Container Card ───────────────────────────────────────── */
#RegisterCard {
    background-color: #F5F0EE;
    border: 1px solid #BFAFB3;
    border-top: 4px solid #3D4BA8;
    border-radius: 0px;
}

#PasswordInput {
    padding-right: 32px;
}

#FormTitle {
    font-family: "Playfair Display", "Georgia", "Times New Roman", serif;
    font-size: 30px;
    font-weight: bold;
    color: #2D1A3E;
}

#FormSubtitle {
    font-size: 14px;
    color: #6B5B77;
}

#FieldLabel {
    font-size: 12px;
    font-weight: bold;
    color: #4E3C5C;
    margin-top: 2px;
}

/* ── Form Inputs ───────────────────────────────────────────────── */
QLineEdit, QDateEdit, QComboBox {
    background-color: #FBF8F7;
    border: 1px solid #BFAFB3;
    border-radius: 0px;
    padding: 11px 14px;
    font-size: 14px;
    color: #2D1A3E;
    selection-background-color: #2D1A3E;
    selection-color: #F5F0EE;
}

QLineEdit:focus, QDateEdit:focus, QComboBox:focus {
    border: 2px solid #3D4BA8;
    padding: 10px 13px;
    background-color: #FFFFFF;
}

#OtpInput {
    font-size: 26px;
    padding: 14px;
}
#OtpInput:focus {
    padding: 13px;
}

/* ── Inline Action Icons (Password Toggle Eye) ─────────────────── */
QLineEdit QToolButton {
    border: none;
    background: transparent;
    padding: 0px 6px;
    color: #6B5B77;
}

QLineEdit QToolButton:hover {
    color: #3D4BA8;
}

/* ── ComboBox dropdown ─────────────────────────────────────────── */
QComboBox::drop-down {
    border: none;
    padding-right: 10px;
}

QComboBox QAbstractItemView {
    background-color: #F5F0EE;
    border: 1px solid #BFAFB3;
    border-radius: 0px;
    color: #2D1A3E;
    selection-background-color: #2D1A3E;
    selection-color: #F5F0EE;
}

/* ── Date Picker Popup ─────────────────────────────────────────── */
QCalendarWidget QWidget {
    background-color: #F5F0EE;
    color: #2D1A3E;
}

QCalendarWidget QAbstractItemView:enabled {
    background-color: #FBF8F7;
    selection-background-color: #2D1A3E;
    selection-color: #F5F0EE;
}

/* ── CAPTCHA ───────────────────────────────────────────────────── */
#CaptchaImage {
    background-color: #FBF8F7;
    border: 1px solid #BFAFB3;
    border-radius: 0px;
}

#CaptchaRefreshBtn {
    background-color: #FBF8F7;
    color: #2D1A3E;
    border: 1px solid #BFAFB3;
    border-radius: 0px;
    padding: 0px;
    font-size: 16px;
}

#CaptchaRefreshBtn:hover {
    background-color: #FFFFFF;
    border: 1px solid #3D4BA8;
}

#CaptchaRefreshBtn:focus {
    border: 2px solid #3D4BA8;
    padding: 0px;
}

/* ── Push Buttons (defaults) ───────────────────────────────────── */
QPushButton {
    background-color: transparent;
    color: #F5F0EE;
    border: none;
    padding: 8px 16px;
    font-size: 14px;
    border-radius: 0px;
}

QPushButton:hover {
    background-color: rgba(216, 203, 199, 0.15);
}

QPushButton:focus {
    border: 2px solid #3D4BA8;
    padding: 6px 14px;
}

QPushButton::menu-indicator {
    image: none;
    width: 0px;
}

/* ── Primary / Secondary Buttons ───────────────────────────────── */
#PrimaryBtn {
    background-color: #2D1A3E;
    color: #F5F0EE;
    font-size: 14px;
    font-weight: bold;
    border-radius: 0px;
    padding: 14px;
    border: none;
}

#PrimaryBtn:hover {
    background-color: #47305C;
}

#PrimaryBtn:focus {
    border: 2px solid #F5F0EE;
    padding: 12px;
}

#SecondaryBtn {
    background-color: transparent;
    color: #6B5B77;
    border: none;
    font-size: 13px;
}

#SecondaryBtn:hover {
    background-color: transparent;
    color: #3D4BA8;
}

#SecondaryBtn:focus {
    border: 2px solid #3D4BA8;
    padding: 6px 14px;
}

/* ── Menus ─────────────────────────────────────────────────────── */
QMenu {
    background-color: #F5F0EE;
    border: 1px solid #BFAFB3;
    border-radius: 0px;
    color: #2D1A3E;
    font-size: 15px;
    padding: 6px 4px;
}

QMenu::item {
    padding: 12px 28px;
    background-color: transparent;
    font-size: 15px;
}

QMenu::item:selected {
    background-color: #2D1A3E;
    color: #F5F0EE;
}

/* ── Scrollbars ────────────────────────────────────────────────── */
QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 0px;
}
QScrollBar::handle:vertical {
    background: #6B5B77;
    min-height: 32px;
    border-radius: 0px;
}
QScrollBar::handle:vertical:hover {
    background: #2D1A3E;
}
QScrollBar:horizontal {
    background: transparent;
    height: 10px;
    margin: 0px;
}
QScrollBar::handle:horizontal {
    background: #6B5B77;
    min-width: 32px;
    border-radius: 0px;
}
QScrollBar::handle:horizontal:hover {
    background: #2D1A3E;
}
QScrollBar::add-line, QScrollBar::sub-line {
    width: 0px;
    height: 0px;
}
QScrollBar::add-page, QScrollBar::sub-page {
    background: none;
}

/* ── Nav bar button tweaks (bigger, per your request) ──────────── */
#NavBar QPushButton {
    color: #2D1A3E;
    font-size: 20px;
    font-weight: 600;
    padding: 6px 10px;
}

#NavBar QPushButton:hover {
    background-color: rgba(45, 26, 62, 0.10);
}

/* Dropdown group buttons in the new grouped nav */
#NavGroupBtn {
    background-color: transparent;
    color: #2D1A3E;
    font-size: 20px;
    font-weight: 600;
    letter-spacing: 0.3px;
    padding: 6px 10px;
    min-height: 30px;
    border: none;
}
#NavGroupBtn:hover,
#NavGroupBtn:checked,
#NavGroupBtn:pressed {
    background-color: rgba(45, 26, 62, 0.10);
    color: #2D1A3E;
}

/* ── Registration page backdrop ────────────────────────────────── */
#RegisterScroll,
#RegisterScroll > QWidget#qt_scrollarea_viewport,
#RegisterScrollContent {
    background-color: #D8CBC7;
    border: none;
}

/* ── Text styling ──────────────────────────────────────────────── */
#InstructionText {
    color: #1F2328;
    font-size: 16px;
    font-weight: 600;
    font-family: "Segoe UI", "SF Pro Display", Arial, sans-serif;
}

/* ==========================================================================
   SEARCH BAR — rounded pill, the one soft element
   ========================================================================== */
#SearchBar {
    background-color: #CBB9B4;
    border-bottom: 1px solid #BFAFB3;
    padding: 4px 0;
}

#SearchInput {
    background-color: #FBF8F7;
    border: 1px solid #BFAFB3;
    border-radius: 22px;
    padding: 10px 16px;
    font-size: 13px;
    color: #2D1A3E;
    min-height: 18px;
    selection-background-color: #2D1A3E;
    selection-color: #F5F0EE;
}

#SearchInput:focus {
    border: 2px solid #3D4BA8;
    padding: 9px 15px;
    background-color: #FFFFFF;
}

#SearchCategoryCombo {
    background-color: #FBF8F7;
    border: 1px solid #BFAFB3;
    border-radius: 22px;
    padding: 10px 34px 10px 16px;
    font-size: 13px;
    color: #2D1A3E;
    min-height: 18px;
    min-width: 130px;
}

#SearchCategoryCombo:hover {
    border: 1px solid #3D4BA8;
}

#SearchCategoryCombo:focus {
    border: 2px solid #3D4BA8;
    padding: 9px 33px 9px 15px;
}

#SearchCategoryCombo::drop-down {
    border: none;
    width: 26px;
    subcontrol-origin: padding;
    subcontrol-position: center right;
}

#SearchCategoryCombo::down-arrow {
    image: none;
    width: 0;
    height: 0;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid #4E3C5C;
    margin-right: 12px;
}

#SearchCategoryCombo QAbstractItemView {
    background-color: #F5F0EE;
    border: 1px solid #BFAFB3;
    border-radius: 12px;
    padding: 6px;
    outline: none;
    color: #2D1A3E;
    selection-background-color: #2D1A3E;
    selection-color: #F5F0EE;
}

#SearchBtn {
    background-color: #2D1A3E;
    color: #F5F0EE;
    border: none;
    border-radius: 22px;
    padding: 11px 24px;
    font-size: 13px;
    font-weight: bold;
}

#SearchBtn:hover {
    background-color: #47305C;
}

#SearchBtn:pressed {
    background-color: #1A0F26;
}

#SearchBtn:focus {
    border: 2px solid #F5F0EE;
    padding: 9px 22px;
}

#SearchBtn:disabled {
    background-color: #E4DAD6;
    color: #A89AA0;
}

QListWidget#SearchSuggestions {
    background-color: #F5F0EE;
    border: 1px solid #BFAFB3;
    border-radius: 12px;
    padding: 6px;
    outline: none;
    font-size: 13px;
    color: #2D1A3E;
}

QListWidget#SearchSuggestions::item {
    padding: 8px 12px;
    border-radius: 8px;
}

QListWidget#SearchSuggestions::item:hover {
    background-color: rgba(61, 75, 168, 25);
}

QListWidget#SearchSuggestions::item:selected {
    background-color: #2D1A3E;
    color: #F5F0EE;
}

/* ==========================================================================
   HOME SCROLL AREA — hero + features + opportunities
   ========================================================================== */
#HomeScrollArea,
#HomeScrollArea > QWidget#qt_scrollarea_viewport,
#HomeScrollContent {
    background-color: #D8CBC7;
    border: none;
}

#SectionTitle {
    font-family: "Playfair Display", "Georgia", "Times New Roman", serif;
    font-size: 26px;
    font-weight: bold;
    color: #2D1A3E;
}

/* ==========================================================================
   FEATURES SECTION
   ========================================================================== */
#FeaturesSection {
    background-color: #D8CBC7;
}

#FeatureCard {
    background-color: #F5F0EE;
    border: 1px solid #BFAFB3;
    border-top: 4px solid #3D4BA8;
    border-radius: 0px;
}

#FeatureImage {
    background-color: #FBF8F7;
    border: 1px solid #BFAFB3;
    color: #6B5B77;
    font-size: 13px;
}

#FeatureTitle {
    font-size: 17px;
    font-weight: bold;
    color: #2D1A3E;
}

#FeatureDesc {
    font-size: 13px;
    color: #4E3C5C;
}

/* ==========================================================================
   OPPORTUNITIES SECTION — home carousels
   ========================================================================== */
#OpportunitiesSection {
    background-color: #D8CBC7;
}

#OpportunityRowTitle {
    font-size: 16px;
    font-weight: bold;
    color: #2D1A3E;
    padding-left: 2px;
}

#OpportunityScroll,
#OpportunityScroll > QWidget#qt_scrollarea_viewport,
#OpportunityScrollContent {
    background-color: transparent;
    border: none;
}

#OpportunityEmpty {
    color: #6B5B77;
    font-size: 13px;
    font-style: italic;
    padding: 10px 2px;
}

/* ==========================================================================
   FAQ PAGE
   ========================================================================== */
#FAQPage,
#FAQScrollArea,
#FAQScrollArea > QWidget#qt_scrollarea_viewport,
#FAQScrollContent {
    background-color: #D8CBC7;
    border: none;
}

#FAQTitle {
    font-family: "Playfair Display", "Georgia", "Times New Roman", serif;
    font-size: 26px;
    font-weight: bold;
    color: #2D1A3E;
}

#FAQSearchInput {
    background-color: #FBF8F7;
    border: 1px solid #BFAFB3;
    border-radius: 0px;
    padding: 12px 14px;
    font-size: 14px;
    color: #2D1A3E;
}

#FAQSearchInput:focus {
    border: 2px solid #3D4BA8;
    padding: 11px 13px;
    background-color: #FFFFFF;
}

#FAQItem {
    background-color: #F5F0EE;
    border: 1px solid #BFAFB3;
    border-left: 4px solid #3D4BA8;
    border-radius: 0px;
}

#FAQQuestion {
    font-size: 15px;
    font-weight: bold;
    color: #2D1A3E;
}

#FAQAnswer {
    font-size: 13px;
    color: #4E3C5C;
    padding-top: 6px;
    border-top: 1px solid #BFAFB3;
}

#FAQToggleBtn {
    background-color: #FBF8F7;
    color: #2D1A3E;
    border: 1px solid #BFAFB3;
    font-size: 16px;
    font-weight: bold;
    padding: 2px 0px;
    border-radius: 0px;
}

#FAQToggleBtn:hover {
    background-color: #FFFFFF;
    border-color: #3D4BA8;
}

#FAQToggleBtn:focus {
    border: 2px solid #3D4BA8;
    padding: 1px 0px;
}

#FAQNoResults {
    color: #6B5B77;
    font-size: 14px;
    font-style: italic;
    padding: 20px 0px;
}

/* ==========================================================================
   VOLUNTEER PAGE
   ========================================================================== */
#VolunteerPage,
#VolunteerScroll,
#VolunteerScroll > QWidget#qt_scrollarea_viewport,
#VolunteerGridContainer,
#VolunteerListContainer,
#VolunteerContentStack,
#VolunteerEmptyWrap {
    background-color: #D8CBC7;
    border: none;
}

#VolunteerHeader {
    background-color: #C1AEA8;
    border-bottom: 1px solid #BFAFB3;
}

#VolunteerTitle {
    font-family: "Playfair Display", "Georgia", "Times New Roman", serif;
    font-size: 24px;
    font-weight: bold;
    color: #2D1A3E;
    padding-left: 10px;
}

#VolunteerBackBtn {
    background-color: transparent;
    color: #2D1A3E;
    font-size: 14px;
    font-weight: bold;
    padding: 8px 14px;
    border: 1px solid #BFAFB3;
}
#VolunteerBackBtn:hover {
    background-color: rgba(45, 26, 62, 0.10);
}
#VolunteerBackBtn:focus {
    border: 2px solid #3D4BA8;
    padding: 7px 13px;
}

#ViewToggleBtn {
    background-color: #FBF8F7;
    color: #2D1A3E;
    border: 1px solid #BFAFB3;
    padding: 8px 16px;
    font-size: 13px;
    font-weight: bold;
}
#ViewToggleBtn:checked {
    background-color: #2D1A3E;
    color: #F5F0EE;
    border: 1px solid #2D1A3E;
}
#ViewToggleBtn:hover {
    border: 1px solid #3D4BA8;
}
#ViewToggleBtn:focus {
    border: 2px solid #3D4BA8;
    padding: 7px 15px;
}

#VolunteerResultsCount {
    font-size: 13px;
    color: #4E3C5C;
    font-style: italic;
}

#VolunteerEmpty {
    font-size: 15px;
    color: #6B5B77;
    font-style: italic;
}

#VolunteerEmptyBtn {
    background-color: #2D1A3E;
    color: #F5F0EE;
    font-size: 13px;
    font-weight: bold;
    padding: 10px 22px;
    border: none;
}
#VolunteerEmptyBtn:hover {
    background-color: #47305C;
}
#VolunteerEmptyBtn:focus {
    border: 2px solid #F5F0EE;
    padding: 8px 20px;
}

/* ── Filter bar ────────────────────────────────────────────────── */
#FilterBar {
    background-color: #CBB9B4;
    border-bottom: 1px solid #BFAFB3;
}

#FilterMoreRow {
    background-color: transparent;
}

#FilterLabel {
    font-size: 13px;
    font-weight: bold;
    color: #4E3C5C;
}

#FilterSearchInput,
#FilterLocationInput,
#FilterCombo,
#FilterDate {
    background-color: #FBF8F7;
    border: 1px solid #BFAFB3;
    border-radius: 0px;
    padding: 9px 12px;
    font-size: 13px;
    color: #2D1A3E;
    min-height: 18px;
}
#FilterSearchInput:focus,
#FilterLocationInput:focus,
#FilterCombo:focus,
#FilterDate:focus {
    border: 2px solid #3D4BA8;
    padding: 8px 11px;
    background-color: #FFFFFF;
}

#FilterClearBtn,
#FilterMoreBtn,
#DetailsCloseBtn {
    background-color: transparent;
    color: #4E3C5C;
    border: 1px solid #BFAFB3;
    padding: 8px 14px;
    font-size: 13px;
}
#FilterClearBtn:hover,
#FilterMoreBtn:hover,
#DetailsCloseBtn:hover {
    background-color: #FFFFFF;
    color: #3D4BA8;
    border-color: #3D4BA8;
}
#FilterMoreBtn:checked {
    background-color: #FFFFFF;
    color: #2D1A3E;
    border-color: #3D4BA8;
}
#FilterClearBtn:focus,
#FilterMoreBtn:focus,
#DetailsCloseBtn:focus {
    border: 2px solid #3D4BA8;
    padding: 7px 13px;
}

/* ==========================================================================
   EVENT CARD (grid + list)
   ========================================================================== */
#EventCard {
    background-color: #FFFFFF;
    border: 1px solid #D8DCE3;
    border-radius: 0px;
}
#EventCard:hover {
    border: 1px solid #B1A2A8;
}

#EventCardMoxie {
    background-color: #FFFFFF;
    border: 2px solid #B1A2A8;
    border-radius: 0px;
}
#EventCardMoxie:hover {
    border: 2px solid #8A7A82;
}

#EventThumb {
    background-color: #F1ECEE;
    border: none;
    color: #7A6F73;
    font-size: 12px;
}

#EventCategoryBadge {
    background-color: #3D4BA8;
    color: #F5F0EE;
    font-size: 10px;
    font-weight: bold;
    padding: 4px 10px;
}

#EventLocationBadge {
    background-color: transparent;
    color: #4E3C5C;
    font-size: 10px;
    font-weight: bold;
    padding: 3px 8px;
    border: 1px solid #BFAFB3;
}

#EventStatusBadge {
    background-color: #2D1A3E;
    color: #F5F0EE;
    font-size: 10px;
    font-weight: bold;
    padding: 4px 8px;
}

#EventTitle {
    font-size: 15px;
    font-weight: bold;
    color: #2D1A3E;
}

#EventTitleList {
    font-size: 17px;
    font-weight: bold;
    color: #2D1A3E;
}

#EventOrg {
    font-size: 12px;
    color: #6B5B77;
    font-style: italic;
}

#EventDescription {
    font-size: 12px;
    color: #4E3C5C;
}

#EventMetaKey {
    font-size: 12px;
    color: #6B5B77;
    font-weight: bold;
}

#EventMetaValue {
    font-size: 12px;
    color: #2D1A3E;
    font-weight: bold;
}

#EventLinkBtn {
    background-color: #2D1A3E;
    color: #F5F0EE;
    font-size: 12px;
    font-weight: bold;
    border: none;
    padding: 9px 14px;
}
#EventLinkBtn:hover {
    background-color: #47305C;
}
#EventLinkBtn:disabled {
    background-color: #E4DAD6;
    color: #A89AA0;
}
#EventLinkBtn:focus {
    border: 2px solid #F5F0EE;
    padding: 7px 12px;
}

#EventRsvpBtn {
    background-color: #3D4BA8;
    color: #F5F0EE;
    font-size: 12px;
    font-weight: bold;
    border: none;
    padding: 9px 14px;
}
#EventRsvpBtn:hover {
    background-color: #2F3B8A;
}
#EventRsvpBtn:disabled {
    background-color: #E4DAD6;
    color: #A89AA0;
}
#EventRsvpBtn:focus {
    border: 2px solid #F5F0EE;
    padding: 7px 12px;
}

/* ── Event details dialog ─────────────────────────────────────── */
#EventDetailsDialog {
    background-color: #F5F0EE;
    border: 1px solid #BFAFB3;
    border-top: 4px solid #3D4BA8;
    border-radius: 0px;
}

#DetailsScroll,
#DetailsScroll > QWidget#qt_scrollarea_viewport,
#DetailsScrollContent {
    background-color: transparent;
    border: none;
}

#DetailsDescription {
    font-size: 13px;
    color: #4E3C5C;
}

/* ==========================================================================
   GLOBAL MICROPHONE BUTTON
   ========================================================================== */
QPushButton#GlobalMic {
    background: #2D1A3E;
    color: white;
    border: none;
    border-radius: 22px;
    font-size: 18px;
}
QPushButton#GlobalMic:hover {
    background: #47305C;
}
QPushButton#GlobalMic:pressed {
    background: #1A0F26;
}
QPushButton#GlobalMic[listening="true"] {
    background: #C0392B;
    font-size: 20px;
}

/* ── Chat widget ───────────────────────────────────────────────── */
#ChatView,
#ChatScrollArea,
#ChatScrollArea > QWidget#qt_scrollarea_viewport,
#ChatTranscript {
    background-color: transparent;
    border: none;
}

#ChatComposer {
    background-color: rgba(45, 26, 62, 0.08);
    border: 1px solid #BFAFB3;
    border-radius: 24px;
}

QLineEdit#ChatInput {
    background: transparent;
    border: none;
    color: #2D1A3E;
    selection-background-color: #2D1A3E;
    selection-color: #F5F0EE;
}

QPushButton#ChatIconButton {
    background-color: #2D1A3E;
    color: #F5F0EE;
    border: 1px solid #BFAFB3;
}
QPushButton#ChatIconButton:hover {
    background-color: #47305C;
}
QPushButton#ChatIconButton:pressed {
    background-color: #1A0F26;
}
QPushButton#ChatIconButton:checked {
    background-color: #C0392B;
    color: #F5F0EE;
}

QLabel#ChatUserBubbleFirst,
QLabel#ChatUserBubbleGrouped {
    background-color: #2D1A3E;
    color: #F5F0EE;
    padding: 8px 12px;
    font-size: 13px;
}
QLabel#ChatUserBubbleFirst {
    border-top-left-radius: 16px;
    border-top-right-radius: 16px;
    border-bottom-right-radius: 4px;
    border-bottom-left-radius: 16px;
}
QLabel#ChatUserBubbleGrouped {
    border-radius: 16px;
}

QLabel#ChatAssistantBubbleFirst,
QLabel#ChatAssistantBubbleGrouped,
QLabel#ChatTypingBubble {
    background-color: #F5F0EE;
    color: #2D1A3E;
    border: 1px solid #D8DCE3;
    padding: 8px 12px;
    font-size: 13px;
}
QLabel#ChatAssistantBubbleFirst,
QLabel#ChatTypingBubble {
    border-top-left-radius: 4px;
    border-top-right-radius: 16px;
    border-bottom-right-radius: 16px;
    border-bottom-left-radius: 16px;
}
QLabel#ChatAssistantBubbleGrouped {
    border-radius: 16px;
}
QLabel#ChatTypingBubble {
    color: #6B5B77;
    padding: 8px 14px;
    font-size: 11px;
}

QLabel#ChatAvatar {
    background-color: #2D1A3E;
    color: #F5F0EE;
    border-radius: 14px;
    font-size: 13px;
    font-weight: bold;
}

QLabel#ChatTimestamp,
QLabel#ChatDateLabel {
    color: #6B5B77;
    padding: 0 6px;
}
QLabel#ChatTimestamp { font-size: 10px; }
QLabel#ChatDateLabel { font-size: 11px; font-weight: 600; }

QFrame#ChatDateRule {
    color: #BFAFB3;
}

QDialog#ChatHistoryDialog,
QListWidget#ChatHistoryList {
    background-color: #F5F0EE;
    color: #2D1A3E;
}
QListWidget#ChatHistoryList {
    border: 1px solid #BFAFB3;
    selection-background-color: #2D1A3E;
    selection-color: #F5F0EE;
}
QLabel#ChatHistoryEmpty {
    color: #4E3C5C;
}

/* ── Opportunity source badges ───────────────────────────────── */
QLabel#EventSourceMoxie {
    background-color: #2D1A3E;
    color: #F5F0EE;
    border-radius: 9px;
    padding: 3px 10px;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.5px;
}
QLabel#EventSourceExternal {
    background-color: transparent;
    color: #8C8C8C;
    border: 1px solid #8C8C8C;
    border-radius: 9px;
    padding: 2px 9px;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.5px;
}

/* ── Full-width "Open Details" button on event cards ─────────── */
/* CHANGED: opaque blueberry fill instead of transparent (per request) */
QPushButton#EventDetailsBtn {
    background-color: #3D4BA8;
    color: #F5F0EE;
    border: 1px solid #3D4BA8;
    border-radius: 8px;
    padding: 8px 12px;
    font-size: 12px;
    font-weight: 600;
}
QPushButton#EventDetailsBtn:hover {
    background-color: #2F3B8A;
    border-color: #2F3B8A;
}
QPushButton#EventDetailsBtn:pressed {
    background-color: #2D1A3E;
    border-color: #2D1A3E;
}
QPushButton#EventDetailsBtn:focus {
    border: 2px solid #F5F0EE;
    padding: 7px 11px;
}

/* ── Bookmark button on event cards (new) ───────────────────── */
QPushButton#EventBookmarkBtn {
    background-color: #FBF8F7;
    color: #6B5B77;
    border: 1px solid #BFAFB3;
    border-radius: 8px;
    font-size: 18px;
    padding: 0;
    min-width: 34px;
    min-height: 34px;
}
QPushButton#EventBookmarkBtn:hover {
    color: #3D4BA8;
    border-color: #3D4BA8;
}
QPushButton#EventBookmarkBtn:focus {
    border: 2px solid #3D4BA8;
}
QPushButton#EventBookmarkBtnOn {
    background-color: #3D4BA8;
    color: #F5F0EE;
    border: 1px solid #3D4BA8;
    border-radius: 8px;
    font-size: 18px;
    padding: 0;
    min-width: 34px;
    min-height: 34px;
}
QPushButton#EventBookmarkBtnOn:hover {
    background-color: #2F3B8A;
}

/* ── Standard back button used on every sub-page ────────────── */
QPushButton#BackBtn {
    background-color: #BFAFB3;
    border: 1px solid rgba(127, 127, 127, 90);
    border-radius: 8px;
    padding: 6px 14px;
    font-size: 13px;
    font-weight: 600;
    color: #2D1A3E;
}
QPushButton#BackBtn:hover {
    background-color: rgba(127, 127, 127, 30);
    border-color: rgba(127, 127, 127, 160);
}
QPushButton#BackBtn:pressed {
    background-color: rgba(127, 127, 127, 60);
}

/* ── Mission hero typography (old hero section) ──────────────── */
QLabel#HeroMissionTitle {
    font-size: 90px;
    font-weight: 900;
    letter-spacing: -2px;
    color: #2D1A3E;
}
QLabel#HeroMissionBodyLg {
    font-size: 25px;
    font-weight: 400;
    color: #2D1A3E;
}
QLabel#HeroMissionBodyMd {
    font-size: 30px;
    font-weight: 400;
    color: #2D1A3E;
}
QLabel#HeroMissionBodySm {
    font-size: 25px;
    font-weight: 700;
    color: #2D1A3E;
}

/* ── Learn More button ──────────────────────────────────────── */
QPushButton#HeroLearnBtn {
    border: none;
    border-radius: 8px;
    font-size: 15px;
    font-weight: 700;
    background-color: #2D1A3E;
    color: #F5F0EE;
}
QPushButton#HeroLearnBtn:hover {
    background-color: #4A2C66;
}
QPushButton#HeroLearnBtn:pressed {
    background-color: #1F1129;
}

/* ==========================================================================
   HERO — editorial split-panel (new layout)
   ========================================================================== */
#HeroSection    { background-color: #D8CBC7; }
#HeroLeftPanel  { background-color: #D8CBC7; }
#HeroRightPanel { background-color: #F5F0EE; }
#HeroBottomBar  { background-color: #2D1A3E; }
#HeroWordmark   { padding: 0; margin: 0; }

#HeroHeadline {
    font-family: "Playfair Display", "Georgia", "Times New Roman", serif;
    font-size: 44px;
    font-weight: 700;
    color: #2D1A3E;
    line-height: 1.15em;
}
#HeroSub {
    font-size: 15px;
    color: #4E3C5C;
    line-height: 1.55em;
}
#HeroPhoto {
    background-color: #F5F0EE;
    border: none;
}

/* ==========================================================================
   VOLUNTEER MATCH PAGE (new)
   ========================================================================== */
#MatchPage {
    background-color: #D8CBC7;
    border: none;
}
#MatchCard {
    background-color: #F5F0EE;
    border: 1px solid #BFAFB3;
    border-top: 4px solid #3D4BA8;
    border-radius: 0px;
}
#MatchStepTitle {
    font-family: "Playfair Display", "Georgia", "Times New Roman", serif;
    font-size: 22px;
    font-weight: bold;
    color: #2D1A3E;
}
#MatchChip {
    background-color: #FBF8F7;
    color: #2D1A3E;
    border: 1px solid #BFAFB3;
    padding: 10px 16px;
    font-size: 13px;
    border-radius: 0px;
    text-align: left;
}
#MatchChip:hover {
    border-color: #3D4BA8;
}
#MatchChip:checked,
#MatchChipChecked {
    background-color: #2D1A3E;
    color: #F5F0EE;
    border: 1px solid #2D1A3E;
}

/* ==========================================================================
   CAREER CLUSTER MULTI-SELECT (new)
   ========================================================================== */
#ClusterMultiSelect {
    background-color: transparent;
    border: none;
}
#ClusterChip {
    background-color: #FBF8F7;
    color: #2D1A3E;
    border: 1px solid #BFAFB3;
    padding: 8px 14px;
    font-size: 12px;
    border-radius: 0px;
    text-align: left;
}
#ClusterChip:hover {
    border-color: #3D4BA8;
}
#ClusterChip:checked,
#ClusterChipChecked {
    background-color: #2D1A3E;
    color: #F5F0EE;
    border: 1px solid #2D1A3E;
}

/* ==========================================================================
   QR / TIME-GATED EVENT VIEW (new)
   ========================================================================== */
#EventQrDialog {
    background-color: #F5F0EE;
    border: 1px solid #BFAFB3;
    border-top: 4px solid #3D4BA8;
}
#EventQrImage {
    background-color: #F5F0EE;
    border: 1px solid #BFAFB3;
}
#EventQrStatus {
    font-size: 14px;
    font-weight: bold;
    color: #2D1A3E;
}
#EventQrWindow {
    font-size: 12px;
    color: #6B5B77;
}

/* ==========================================================================
   EXPORT DIALOG (new)
   ========================================================================== */
#ExportDialog {
    background-color: #F5F0EE;
    border: 1px solid #BFAFB3;
    border-top: 4px solid #3D4BA8;
}
#ExportSection {
    background-color: #F5F0EE;
    border: 1px solid #BFAFB3;
}
#ExportFormatRow {
    background-color: transparent;
    border: none;
}
/* ==========================================================================
   ORG DASHBOARD — cards, tables, alerts, recommendations
   ========================================================================== */

/* Stat tiles across the top of the Overview page */
#OrgStatTile {
    background-color: #F5F0EE;
    border: 1px solid #BFAFB3;
    border-radius: 0px;
}
#OrgStatValue {
    font-size: 32px;
    font-weight: 700;
    color: #2D1A3E;
}
#OrgStatCaption {
    font-size: 12px;
    color: #4E3C5C;
}

/* Headline pair inside overview / announcement cards */
#OrgRowMain {
    font-size: 14px;
    color: #2D1A3E;
    font-weight: 600;
}
#OrgRowSub {
    font-size: 12px;
    color: #6B5B77;
}

/* Small inline "Open reports →" links on dashboard cards */
#OrgCardLink {
    background: transparent;
    border: none;
    color: #3D4BA8;
    font-size: 12px;
    font-weight: 700;
    padding: 4px 8px;
}
#OrgCardLink:hover {
    color: #2F3B8A;
    text-decoration: underline;
}

/* Opportunity list */
#OrgOppList {
    background-color: #F5F0EE;
    border: 1px solid #BFAFB3;
    outline: none;
    font-size: 13px;
    color: #2D1A3E;
}
#OrgOppList::item {
    padding: 12px 14px;
    border-bottom: 1px solid #BFAFB3;
}
#OrgOppList::item:hover {
    background-color: rgba(61, 75, 168, 12);
}
#OrgOppList::item:selected {
    background-color: #2D1A3E;
    color: #F5F0EE;
}

/* ── Recommendations table ───────────────────────────────────── */
#OrgRecBlock {
    background-color: #F5F0EE;
    border: 1px solid #BFAFB3;
    border-top: 4px solid #3D4BA8;
}
#OrgRecDivider {
    background-color: #BFAFB3;
    border: none;
}
#OrgRecTableHeader {
    background-color: #E4DAD6;
}
#OrgRecColLabel {
    color: #4E3C5C;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.6px;
    text-transform: uppercase;
}
#OrgRecRow {
    background-color: #FFFFFF;
    border: 1px solid #D8DCE3;
}
#OrgRecRow:hover {
    border-color: #3D4BA8;
}
#OrgRecAvatar {
    background-color: #3D4BA8;
    color: #F5F0EE;
    border-radius: 19px;
    font-size: 14px;
    font-weight: 700;
}
#OrgRecName {
    font-size: 14px;
    font-weight: 700;
    color: #2D1A3E;
}
#OrgRecSub {
    font-size: 12px;
    color: #6B5B77;
}
#OrgRecScore {
    background-color: #3D4BA8;
    color: #F5F0EE;
    font-size: 12px;
    font-weight: 700;
    border-radius: 12px;
    padding: 4px 10px;
}
#OrgRecReason {
    font-size: 12px;
    color: #4E3C5C;
}

/* ==========================================================================
   NOTIFICATIONS — social-media style feed
   ========================================================================== */
#NotifCard {
    background-color: #F5F0EE;
    border: 1px solid #BFAFB3;
    border-left: 4px solid #3D4BA8;
    border-radius: 8px;
    margin: 2px 0;
}
#NotifCard:hover {
    border-color: #3D4BA8;
}
#NotifAvatar {
    background-color: #3D4BA8;
    color: #F5F0EE;
    border-radius: 19px;
    font-size: 14px;
    font-weight: 700;
}
#NotifName {
    font-size: 14px;
    font-weight: 700;
    color: #2D1A3E;
}
#NotifSubject {
    font-size: 14px;
    font-weight: 700;
    color: #2D1A3E;
    padding-top: 2px;
}
#NotifTimestamp {
    font-size: 11px;
    color: #6B5B77;
}
#NotifTypeChip {
    background-color: #3D4BA8;
    color: #F5F0EE;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.4px;
    padding: 3px 9px;
    border-radius: 9px;
}
#NotifBody {
    font-size: 13px;
    color: #2D1A3E;
    padding-left: 50px;
}
#NotifDayHeader {
    font-size: 11px;
    font-weight: 700;
    color: #4E3C5C;
    padding: 10px 2px 2px 2px;
    letter-spacing: 1px;
}
/* ==========================================================================
   MOXIE DASHBOARD — KPI tiles, chart cards, section labels
   ========================================================================== */
#MoxieKpiTile {
    background-color: #F5F0EE;
    border: 1px solid #BFAFB3;
    border-top: 3px solid #3D4BA8;
    border-radius: 0px;
}
#MoxieKpiTile:hover {
    border-top: 3px solid #2D1A3E;
}
#MoxieKpiValue {
    font-family: "Playfair Display", "Georgia", "Times New Roman", serif;
    font-size: 34px;
    font-weight: 900;
    color: #2D1A3E;
    letter-spacing: -1px;
}
#MoxieKpiCaption {
    font-size: 11px;
    font-weight: 700;
    color: #6B5B77;
    text-transform: uppercase;
    letter-spacing: 1px;
}
#MoxieKpiDelta {
    font-size: 12px;
    font-weight: 700;
    padding: 3px 8px;
    border-radius: 10px;
    color: #6B5B77;
    background-color: #E4DAD6;
}
#MoxieKpiDelta[trend="up"]   { color: #F5F0EE; background-color: #3D4BA8; }
#MoxieKpiDelta[trend="down"] { color: #F5F0EE; background-color: #C0392B; }
#MoxieKpiDelta[trend="flat"] { color: #6B5B77; background-color: #E4DAD6; }

#MoxieSectionLabel {
    font-size: 11px;
    font-weight: 800;
    color: #6B5B77;
    letter-spacing: 1.6px;
    text-transform: uppercase;
    padding: 4px 0 2px 0;
}
#MoxieSectionTitle {
    font-family: "Playfair Display", "Georgia", "Times New Roman", serif;
    font-size: 20px;
    font-weight: 700;
    color: #2D1A3E;
    padding: 0;
}

/* Big hero title on the dashboard overview */
#MoxieHeroTitle {
    font-family: "Playfair Display", "Georgia", "Times New Roman", serif;
    font-size: 40px;
    font-weight: 900;
    color: #2D1A3E;
    letter-spacing: -0.5px;
}
#MoxieHeroSub {
    font-size: 15px;
    color: #6B5B77;
    padding-bottom: 4px;
}

/* Card wrapper for each chart block */
#MoxieChartCard {
    background-color: #FFFFFF;
    border: 1px solid #D8DCE3;
    border-radius: 0px;
}
#MoxieChartCardDarkAccent {
    background-color: #F5F0EE;
    border: 1px solid #BFAFB3;
    border-top: 4px solid #2D1A3E;
}
#MoxieChartCardBlueAccent {
    background-color: #F5F0EE;
    border: 1px solid #BFAFB3;
    border-top: 4px solid #3D4BA8;
}

/* Compact pill-style action row on the dashboard hero */
#MoxieHeroAction {
    background-color: #2D1A3E;
    color: #F5F0EE;
    font-size: 13px;
    font-weight: 700;
    padding: 12px 22px;
    border: none;
    border-radius: 0px;
}
#MoxieHeroAction:hover { background-color: #3D4BA8; }
#MoxieHeroActionSecondary {
    background-color: transparent;
    color: #2D1A3E;
    border: 1px solid #BFAFB3;
    font-size: 13px;
    font-weight: 700;
    padding: 12px 22px;
    border-radius: 0px;
}
#MoxieHeroActionSecondary:hover {
    border-color: #3D4BA8;
    color: #3D4BA8;
}
/* ==========================================================================
   FILTER SIDEBAR
   ========================================================================== */
#FilterSidebar {
    background-color: #C1AEA8;
    border-right: 1px solid #BFAFB3;
}
#FilterSidebarScroll,
#FilterSidebarScroll > QWidget#qt_scrollarea_viewport,
#FilterSidebarContent {
    background-color: #C1AEA8;
    border: none;
}
#FilterSidebarHeading {
    font-size: 11px;
    font-weight: 800;
    color: #4E3C5C;
    letter-spacing: 1.4px;
    text-transform: uppercase;
    padding: 6px 0 2px 0;
}
#FilterSidebarInput {
    background-color: #FBF8F7;
    border: 1px solid #BFAFB3;
    padding: 9px 12px;
    font-size: 13px;
    color: #2D1A3E;
    min-height: 18px;
}
#FilterSidebarInput:focus {
    border: 2px solid #3D4BA8;
    padding: 8px 11px;
    background-color: #FFFFFF;
}
#FilterSidebarRadio,
#FilterSidebarCheck {
    font-size: 13px;
    color: #2D1A3E;
    spacing: 8px;
    padding: 4px 0;
}
#FilterSidebarRadio::indicator,
#FilterSidebarCheck::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #BFAFB3;
    background-color: #FBF8F7;
}
#FilterSidebarCheck::indicator:checked,
#FilterSidebarRadio::indicator:checked {
    background-color: #3D4BA8;
    border-color: #3D4BA8;
}
#FilterSidebarClear {
    background-color: #2D1A3E;
    color: #F5F0EE;
    font-size: 13px;
    font-weight: 700;
    padding: 12px;
    border: none;
    margin: 8px;
}
#FilterSidebarClear:hover {
    background-color: #3D4BA8;
}