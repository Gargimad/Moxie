/* ==========================================================================
   MOXIE BRAND PALETTE — DARK MODE

   Same design rule as light mode:
     - Square corners everywhere. Every border-radius is 0.
     - Exception: the search bar is a rounded pill (border-radius: 22px).
     - Also rounded: BackBtn (8px), EventDetailsBtn (8px), source badges
       (9px), search suggestion popup (12px), chat bubbles (16px).

   Palette — dark
   --------------------------------------------------------------------------
   Page background         #1E1626
   Nav / Header Surface    #2A1F33
   Filter Surface          #261C2E
   Card Surface            #2E2238
   Input Surface           #251A2E
   Input Surface Focus     #352543
   Border                  #4A3A54
   Border Soft             #3A2C43
   Disabled Surface        #3A2C43

   Brand core — brightened for contrast on dark
   --------------------------------------------------------------------------
   Moxie Purple (brand)    #B39CDB
   Purple Hover            #C9B4EC
   Blueberry (accent)      #7B8BE0
   Blueberry Hover         #93A2F0

   Text
   --------------------------------------------------------------------------
   Text on Dark            #F5F0EE
   Text Primary            #EDE6F2
   Text Label              #C7B9D4
   Text Muted              #9C8EA9
   Text Disabled           #6B5B77

   Recording Red           #E74C3C
   ========================================================================== */

/* ── Window & General Layout ───────────────────────────────────── */
QMainWindow {
    background-color: #1E1626;
}

#NavBar {
    background-color: #2A1F33;
    border-bottom: 1px solid rgba(216, 203, 199, 0.10);
    color: #EDE6F2;
    min-height: 70px;
}

#NavLogo {
    color: #F5F0EE;
    font-size: 30px;
    font-weight: bold;
}

#HeroLogo {
    font-size: 60px;
}

#BottomBar {
    background-color: #2A1F33;
    border-top: 1px solid #4A3A54;
}

#SloganText {
    font-size: 20px;
    color: #EDE6F2;
}

/* ── Form Container Card ───────────────────────────────────────── */
#RegisterCard {
    background-color: #2E2238;
    border: 1px solid #4A3A54;
    border-top: 4px solid #7B8BE0;
    border-radius: 0px;
}

#PasswordInput {
    padding-right: 32px;
}

#FormTitle {
    font-family: "Playfair Display", "Georgia", "Times New Roman", serif;
    font-size: 30px;
    font-weight: bold;
    color: #EDE6F2;
}

#FormSubtitle {
    font-size: 14px;
    color: #9C8EA9;
}

#FieldLabel {
    font-size: 12px;
    font-weight: bold;
    color: #C7B9D4;
    margin-top: 2px;
}

/* ── Form Inputs ───────────────────────────────────────────────── */
QLineEdit, QDateEdit, QComboBox {
    background-color: #251A2E;
    border: 1px solid #4A3A54;
    border-radius: 0px;
    padding: 11px 14px;
    font-size: 14px;
    color: #EDE6F2;
    selection-background-color: #B39CDB;
    selection-color: #1E1626;
}

QLineEdit:focus, QDateEdit:focus, QComboBox:focus {
    border: 2px solid #7B8BE0;
    padding: 10px 13px;
    background-color: #352543;
}

#OtpInput {
    font-size: 26px;
    padding: 14px;
}
#OtpInput:focus {
    padding: 13px;
}

/* ── Inline Action Icons (Password Toggle Eye) ─────────────────── */
QLineEdit QToolButton {
    border: none;
    background: transparent;
    padding: 0px 6px;
    color: #9C8EA9;
}
QLineEdit QToolButton:hover {
    color: #7B8BE0;
}

/* ── ComboBox dropdown ─────────────────────────────────────────── */
QComboBox::drop-down {
    border: none;
    padding-right: 10px;
}

QComboBox QAbstractItemView {
    background-color: #2E2238;
    border: 1px solid #4A3A54;
    border-radius: 0px;
    color: #EDE6F2;
    selection-background-color: #B39CDB;
    selection-color: #1E1626;
}

/* ── Date Picker Popup ─────────────────────────────────────────── */
QCalendarWidget QWidget {
    background-color: #2E2238;
    color: #EDE6F2;
}

QCalendarWidget QAbstractItemView:enabled {
    background-color: #251A2E;
    selection-background-color: #B39CDB;
    selection-color: #1E1626;
}

/* ── CAPTCHA ───────────────────────────────────────────────────── */
#CaptchaImage {
    background-color: #251A2E;
    border: 1px solid #4A3A54;
    border-radius: 0px;
}

#CaptchaRefreshBtn {
    background-color: #251A2E;
    color: #EDE6F2;
    border: 1px solid #4A3A54;
    border-radius: 0px;
    padding: 0px;
    font-size: 16px;
}
#CaptchaRefreshBtn:hover {
    background-color: #352543;
    border: 1px solid #7B8BE0;
}
#CaptchaRefreshBtn:focus {
    border: 2px solid #7B8BE0;
    padding: 0px;
}

/* ── Push Buttons (defaults) ───────────────────────────────────── */
QPushButton {
    background-color: transparent;
    color: #EDE6F2;
    border: none;
    padding: 8px 16px;
    font-size: 14px;
    border-radius: 0px;
}
QPushButton:hover {
    background-color: rgba(179, 156, 219, 0.12);
}
QPushButton:focus {
    border: 2px solid #7B8BE0;
    padding: 6px 14px;
}
QPushButton::menu-indicator {
    image: none;
    width: 0px;
}

/* ── Primary / Secondary Buttons ───────────────────────────────── */
#PrimaryBtn {
    background-color: #B39CDB;
    color: #1E1626;
    font-size: 14px;
    font-weight: bold;
    border-radius: 0px;
    padding: 14px;
    border: none;
}
#PrimaryBtn:hover {
    background-color: #C9B4EC;
}
#PrimaryBtn:focus {
    border: 2px solid #F5F0EE;
    padding: 12px;
}

#SecondaryBtn {
    background-color: transparent;
    color: #9C8EA9;
    border: none;
    font-size: 13px;
}
#SecondaryBtn:hover {
    background-color: transparent;
    color: #7B8BE0;
}
#SecondaryBtn:focus {
    border: 2px solid #7B8BE0;
    padding: 6px 14px;
}

/* ── Menus ─────────────────────────────────────────────────────── */
QMenu {
    background-color: #2E2238;
    border: 1px solid #4A3A54;
    border-radius: 0px;
    color: #EDE6F2;
    font-size: 15px;
    padding: 6px 4px;
}
QMenu::item {
    padding: 12px 28px;
    background-color: transparent;
    font-size: 15px;
}
QMenu::item:selected {
    background-color: #B39CDB;
    color: #1E1626;
}

/* ── Scrollbars ────────────────────────────────────────────────── */
QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 0px;
}
QScrollBar::handle:vertical {
    background: #6B5B77;
    min-height: 32px;
    border-radius: 0px;
}
QScrollBar::handle:vertical:hover {
    background: #B39CDB;
}
QScrollBar:horizontal {
    background: transparent;
    height: 10px;
    margin: 0px;
}
QScrollBar::handle:horizontal {
    background: #6B5B77;
    min-width: 32px;
    border-radius: 0px;
}
QScrollBar::handle:horizontal:hover {
    background: #B39CDB;
}
QScrollBar::add-line, QScrollBar::sub-line {
    width: 0px;
    height: 0px;
}
QScrollBar::add-page, QScrollBar::sub-page {
    background: none;
}

/* ── Nav bar button tweaks (bigger, per your request) ──────────── */
#NavBar QPushButton {
    color: #EDE6F2;
    font-size: 20px;
    font-weight: 600;
    padding: 6px 10px;
}
#NavBar QPushButton:hover {
    background-color: rgba(179, 156, 219, 0.12);
}

/* Dropdown group buttons in the new grouped nav */
#NavGroupBtn {
    background-color: transparent;
    color: #EDE6F2;
    font-size: 20px;
    font-weight: 600;
    letter-spacing: 0.3px;
    padding: 6px 10px;
    min-height: 30px;
    border: none;
}
#NavGroupBtn:hover,
#NavGroupBtn:checked,
#NavGroupBtn:pressed {
    background-color: rgba(179, 156, 219, 0.12);
    color: #EDE6F2;
}

/* ── Registration page backdrop ────────────────────────────────── */
#RegisterScroll,
#RegisterScroll > QWidget#qt_scrollarea_viewport,
#RegisterScrollContent {
    background-color: #1E1626;
    border: none;
}

/* ── Text styling ──────────────────────────────────────────────── */
#InstructionText {
    color: #EDE6F2;
    font-size: 16px;
    font-weight: 600;
    font-family: "Segoe UI", "SF Pro Display", Arial, sans-serif;
}

/* ==========================================================================
   SEARCH BAR — rounded pill
   ========================================================================== */
#SearchBar {
    background-color: #261C2E;
    border-bottom: 1px solid #4A3A54;
    padding: 4px 0;
}

#SearchInput {
    background-color: #251A2E;
    border: 1px solid #4A3A54;
    border-radius: 22px;
    padding: 10px 16px;
    font-size: 13px;
    color: #EDE6F2;
    min-height: 18px;
    selection-background-color: #B39CDB;
    selection-color: #1E1626;
}
#SearchInput:focus {
    border: 2px solid #7B8BE0;
    padding: 9px 15px;
    background-color: #352543;
}

#SearchCategoryCombo {
    background-color: #251A2E;
    border: 1px solid #4A3A54;
    border-radius: 22px;
    padding: 10px 34px 10px 16px;
    font-size: 13px;
    color: #EDE6F2;
    min-height: 18px;
    min-width: 130px;
}
#SearchCategoryCombo:hover {
    border: 1px solid #7B8BE0;
}
#SearchCategoryCombo:focus {
    border: 2px solid #7B8BE0;
    padding: 9px 33px 9px 15px;
}
#SearchCategoryCombo::drop-down {
    border: none;
    width: 26px;
    subcontrol-origin: padding;
    subcontrol-position: center right;
}
#SearchCategoryCombo::down-arrow {
    image: none;
    width: 0;
    height: 0;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid #C7B9D4;
    margin-right: 12px;
}
#SearchCategoryCombo QAbstractItemView {
    background-color: #2E2238;
    border: 1px solid #4A3A54;
    border-radius: 12px;
    padding: 6px;
    outline: none;
    color: #EDE6F2;
    selection-background-color: #B39CDB;
    selection-color: #1E1626;
}

#SearchBtn {
    background-color: #B39CDB;
    color: #1E1626;
    border: none;
    border-radius: 22px;
    padding: 11px 24px;
    font-size: 13px;
    font-weight: bold;
}
#SearchBtn:hover {
    background-color: #C9B4EC;
}
#SearchBtn:pressed {
    background-color: #9A7FC7;
}
#SearchBtn:focus {
    border: 2px solid #F5F0EE;
    padding: 9px 22px;
}
#SearchBtn:disabled {
    background-color: #3A2C43;
    color: #6B5B77;
}

QListWidget#SearchSuggestions {
    background-color: #2E2238;
    border: 1px solid #4A3A54;
    border-radius: 12px;
    padding: 6px;
    outline: none;
    font-size: 13px;
    color: #EDE6F2;
}
QListWidget#SearchSuggestions::item {
    padding: 8px 12px;
    border-radius: 8px;
}
QListWidget#SearchSuggestions::item:hover {
    background-color: rgba(123, 139, 224, 40);
}
QListWidget#SearchSuggestions::item:selected {
    background-color: #B39CDB;
    color: #1E1626;
}

/* ==========================================================================
   HOME SCROLL AREA
   ========================================================================== */
#HomeScrollArea,
#HomeScrollArea > QWidget#qt_scrollarea_viewport,
#HomeScrollContent {
    background-color: #1E1626;
    border: none;
}

#VolunteerDashboard {
    background-color: #1E1626;
    color: #EDE6F2;
}
#VolunteerDashboard QLabel {
    color: #EDE6F2;
}
#VolunteerDashboard #EventCard {
    background-color: #2E2238;
    border: 1px solid #4A3A54;
    border-top: 4px solid #7B8BE0;
}
#VolunteerDashboard #EventCard:hover {
    border: 1px solid #7B8BE0;
    border-top: 4px solid #7B8BE0;
}
#VolunteerDashboard #EventTitleList {
    color: #EDE6F2;
}
#VolunteerDashboard #EventMetaValue {
    color: #C7B9D4;
    font-weight: normal;
}
#VolunteerDashboard #FormSubtitle {
    color: #9C8EA9;
}

#SectionTitle {
    font-family: "Playfair Display", "Georgia", "Times New Roman", serif;
    font-size: 26px;
    font-weight: bold;
    color: #EDE6F2;
}

/* ==========================================================================
   FEATURES SECTION
   ========================================================================== */
#FeaturesSection {
    background-color: #1E1626;
}

#FeatureCard {
    background-color: #2E2238;
    border: 1px solid #4A3A54;
    border-top: 4px solid #7B8BE0;
    border-radius: 0px;
}

#FeatureImage {
    background-color: #251A2E;
    border: 1px solid #4A3A54;
    color: #9C8EA9;
    font-size: 13px;
}

#FeatureTitle {
    font-size: 17px;
    font-weight: bold;
    color: #EDE6F2;
}

#FeatureDesc {
    font-size: 13px;
    color: #C7B9D4;
}

/* ==========================================================================
   OPPORTUNITIES SECTION
   ========================================================================== */
#OpportunitiesSection {
    background-color: #1E1626;
}

#OpportunityRowTitle {
    font-size: 16px;
    font-weight: bold;
    color: #EDE6F2;
    padding-left: 2px;
}

#OpportunityScroll,
#OpportunityScroll > QWidget#qt_scrollarea_viewport,
#OpportunityScrollContent {
    background-color: transparent;
    border: none;
}

#OpportunityEmpty {
    color: #9C8EA9;
    font-size: 13px;
    font-style: italic;
    padding: 10px 2px;
}

/* ==========================================================================
   FAQ PAGE
   ========================================================================== */
#FAQPage,
#FAQScrollArea,
#FAQScrollArea > QWidget#qt_scrollarea_viewport,
#FAQScrollContent {
    background-color: #1E1626;
    border: none;
}

#FAQTitle {
    font-family: "Playfair Display", "Georgia", "Times New Roman", serif;
    font-size: 26px;
    font-weight: bold;
    color: #EDE6F2;
}

#FAQSearchInput {
    background-color: #251A2E;
    border: 1px solid #4A3A54;
    border-radius: 0px;
    padding: 12px 14px;
    font-size: 14px;
    color: #EDE6F2;
}
#FAQSearchInput:focus {
    border: 2px solid #7B8BE0;
    padding: 11px 13px;
    background-color: #352543;
}

#FAQItem {
    background-color: #2E2238;
    border: 1px solid #4A3A54;
    border-left: 4px solid #7B8BE0;
    border-radius: 0px;
}

#FAQQuestion {
    font-size: 15px;
    font-weight: bold;
    color: #EDE6F2;
}

#FAQAnswer {
    font-size: 13px;
    color: #C7B9D4;
    padding-top: 6px;
    border-top: 1px solid #4A3A54;
}

#FAQToggleBtn {
    background-color: #251A2E;
    color: #EDE6F2;
    border: 1px solid #4A3A54;
    font-size: 16px;
    font-weight: bold;
    padding: 2px 0px;
    border-radius: 0px;
}
#FAQToggleBtn:hover {
    background-color: #352543;
    border-color: #7B8BE0;
}
#FAQToggleBtn:focus {
    border: 2px solid #7B8BE0;
    padding: 1px 0px;
}

#FAQNoResults {
    color: #9C8EA9;
    font-size: 14px;
    font-style: italic;
    padding: 20px 0px;
}

/* ==========================================================================
   VOLUNTEER PAGE
   ========================================================================== */
#VolunteerPage,
#VolunteerScroll,
#VolunteerScroll > QWidget#qt_scrollarea_viewport,
#VolunteerGridContainer,
#VolunteerListContainer,
#VolunteerContentStack,
#VolunteerEmptyWrap {
    background-color: #1E1626;
    border: none;
}

#VolunteerHeader {
    background-color: #2A1F33;
    border-bottom: 1px solid #4A3A54;
}

#VolunteerTitle {
    font-family: "Playfair Display", "Georgia", "Times New Roman", serif;
    font-size: 24px;
    font-weight: bold;
    color: #EDE6F2;
    padding-left: 10px;
}

#VolunteerBackBtn {
    background-color: transparent;
    color: #EDE6F2;
    font-size: 14px;
    font-weight: bold;
    padding: 8px 14px;
    border: 1px solid #4A3A54;
}
#VolunteerBackBtn:hover {
    background-color: rgba(179, 156, 219, 0.12);
}
#VolunteerBackBtn:focus {
    border: 2px solid #7B8BE0;
    padding: 7px 13px;
}

#ViewToggleBtn {
    background-color: #251A2E;
    color: #EDE6F2;
    border: 1px solid #4A3A54;
    padding: 8px 16px;
    font-size: 13px;
    font-weight: bold;
}
#ViewToggleBtn:checked {
    background-color: #B39CDB;
    color: #1E1626;
    border: 1px solid #B39CDB;
}
#ViewToggleBtn:hover {
    border: 1px solid #7B8BE0;
}
#ViewToggleBtn:focus {
    border: 2px solid #7B8BE0;
    padding: 7px 15px;
}

#VolunteerResultsCount {
    font-size: 13px;
    color: #C7B9D4;
    font-style: italic;
}

#VolunteerEmpty {
    font-size: 15px;
    color: #9C8EA9;
    font-style: italic;
}

#VolunteerEmptyBtn {
    background-color: #B39CDB;
    color: #1E1626;
    font-size: 13px;
    font-weight: bold;
    padding: 10px 22px;
    border: none;
}
#VolunteerEmptyBtn:hover {
    background-color: #C9B4EC;
}
#VolunteerEmptyBtn:focus {
    border: 2px solid #F5F0EE;
    padding: 8px 20px;
}

/* ── Filter bar ────────────────────────────────────────────────── */
#FilterBar {
    background-color: #261C2E;
    border-bottom: 1px solid #4A3A54;
}

#FilterMoreRow {
    background-color: transparent;
}

#FilterLabel {
    font-size: 13px;
    font-weight: bold;
    color: #C7B9D4;
}

#FilterSearchInput,
#FilterLocationInput,
#FilterCombo,
#FilterDate {
    background-color: #251A2E;
    border: 1px solid #4A3A54;
    border-radius: 0px;
    padding: 9px 12px;
    font-size: 13px;
    color: #EDE6F2;
    min-height: 18px;
}
#FilterSearchInput:focus,
#FilterLocationInput:focus,
#FilterCombo:focus,
#FilterDate:focus {
    border: 2px solid #7B8BE0;
    padding: 8px 11px;
    background-color: #352543;
}

#FilterClearBtn,
#FilterMoreBtn,
#DetailsCloseBtn {
    background-color: transparent;
    color: #C7B9D4;
    border: 1px solid #4A3A54;
    padding: 8px 14px;
    font-size: 13px;
}
#FilterClearBtn:hover,
#FilterMoreBtn:hover,
#DetailsCloseBtn:hover {
    background-color: #352543;
    color: #7B8BE0;
    border-color: #7B8BE0;
}
#FilterMoreBtn:checked {
    background-color: #352543;
    color: #EDE6F2;
    border-color: #7B8BE0;
}
#FilterClearBtn:focus,
#FilterMoreBtn:focus,
#DetailsCloseBtn:focus {
    border: 2px solid #7B8BE0;
    padding: 7px 13px;
}

/* ==========================================================================
   EVENT CARD (grid + list)
   ========================================================================== */
#EventCard {
    background-color: #2E2238;
    border: 1px solid #3A2C43;
    border-radius: 0px;
}
#EventCard:hover {
    border: 1px solid #7B8BE0;
}

#EventCardMoxie {
    background-color: #2E2238;
    border: 2px solid #7B8BE0;
    border-radius: 0px;
}
#EventCardMoxie:hover {
    border: 2px solid #93A2F0;
}

#EventThumb {
    background-color: #251A2E;
    border: none;
    color: #9C8EA9;
    font-size: 12px;
}

#EventCategoryBadge {
    background-color: #7B8BE0;
    color: #1E1626;
    font-size: 10px;
    font-weight: bold;
    padding: 4px 10px;
}

#EventLocationBadge {
    background-color: transparent;
    color: #C7B9D4;
    font-size: 10px;
    font-weight: bold;
    padding: 3px 8px;
    border: 1px solid #4A3A54;
}

#EventStatusBadge {
    background-color: #B39CDB;
    color: #1E1626;
    font-size: 10px;
    font-weight: bold;
    padding: 4px 8px;
}

#EventTitle {
    font-size: 15px;
    font-weight: bold;
    color: #EDE6F2;
}

#EventTitleList {
    font-size: 17px;
    font-weight: bold;
    color: #EDE6F2;
}

#EventOrg {
    font-size: 12px;
    color: #9C8EA9;
    font-style: italic;
}

#EventDescription {
    font-size: 12px;
    color: #C7B9D4;
}

#EventMetaKey {
    font-size: 12px;
    color: #9C8EA9;
    font-weight: bold;
}

#EventMetaValue {
    font-size: 12px;
    color: #EDE6F2;
    font-weight: bold;
}

#EventLinkBtn {
    background-color: #B39CDB;
    color: #1E1626;
    font-size: 12px;
    font-weight: bold;
    border: none;
    padding: 9px 14px;
}
#EventLinkBtn:hover {
    background-color: #C9B4EC;
}
#EventLinkBtn:disabled {
    background-color: #3A2C43;
    color: #6B5B77;
}
#EventLinkBtn:focus {
    border: 2px solid #F5F0EE;
    padding: 7px 12px;
}

#EventRsvpBtn {
    background-color: #7B8BE0;
    color: #F5F0EE;
    font-size: 12px;
    font-weight: bold;
    border: none;
    padding: 9px 14px;
}
#EventRsvpBtn:hover {
    background-color: #93A2F0;
}
#EventRsvpBtn:disabled {
    background-color: #3A2C43;
    color: #6B5B77;
}
#EventRsvpBtn:focus {
    border: 2px solid #F5F0EE;
    padding: 7px 12px;
}

/* ── Event details dialog ─────────────────────────────────────── */
#EventDetailsDialog {
    background-color: #2E2238;
    border: 1px solid #4A3A54;
    border-top: 4px solid #7B8BE0;
    border-radius: 0px;
}

#DetailsScroll,
#DetailsScroll > QWidget#qt_scrollarea_viewport,
#DetailsScrollContent {
    background-color: transparent;
    border: none;
}

#DetailsDescription {
    font-size: 13px;
    color: #C7B9D4;
}

/* ==========================================================================
   GLOBAL MICROPHONE BUTTON
   ========================================================================== */
QPushButton#GlobalMic {
    background: #B39CDB;
    color: #1E1626;
    border: none;
    border-radius: 22px;
    font-size: 18px;
}
QPushButton#GlobalMic:hover {
    background: #C9B4EC;
}
QPushButton#GlobalMic:pressed {
    background: #9A7FC7;
}
QPushButton#GlobalMic[listening="true"] {
    background: #E74C3C;
    font-size: 20px;
}

QMessageBox {
    background-color: #1E1626;
}
QWidget#LoginCard {
    background-color: #2E2238;
}
QDialog {
    background-color: #2E2238;
}

/* ── Chat widget ───────────────────────────────────────────────── */
#ChatView,
#ChatScrollArea,
#ChatScrollArea > QWidget#qt_scrollarea_viewport,
#ChatTranscript {
    background-color: transparent;
    border: none;
}

#ChatComposer {
    background-color: #251A2E;
    border: 1px solid #4A3A54;
    border-radius: 24px;
}

QLineEdit#ChatInput {
    background: transparent;
    border: none;
    color: #EDE6F2;
    selection-background-color: #B39CDB;
    selection-color: #1E1626;
}

QPushButton#ChatIconButton {
    background-color: #B39CDB;
    color: #1E1626;
    border: 1px solid #7B8BE0;
}
QPushButton#ChatIconButton:hover {
    background-color: #C9B4EC;
}
QPushButton#ChatIconButton:pressed {
    background-color: #9A7FC7;
}
QPushButton#ChatIconButton:checked {
    background-color: #E74C3C;
    color: #F5F0EE;
}

QLabel#ChatUserBubbleFirst,
QLabel#ChatUserBubbleGrouped {
    background-color: #7B8BE0;
    color: #1E1626;
    padding: 8px 12px;
    font-size: 13px;
}
QLabel#ChatUserBubbleFirst {
    border-top-left-radius: 16px;
    border-top-right-radius: 16px;
    border-bottom-right-radius: 4px;
    border-bottom-left-radius: 16px;
}
QLabel#ChatUserBubbleGrouped {
    border-radius: 16px;
}

QLabel#ChatAssistantBubbleFirst,
QLabel#ChatAssistantBubbleGrouped,
QLabel#ChatTypingBubble {
    background-color: #2E2238;
    color: #EDE6F2;
    border: 1px solid #4A3A54;
    padding: 8px 12px;
    font-size: 13px;
}
QLabel#ChatAssistantBubbleFirst,
QLabel#ChatTypingBubble {
    border-top-left-radius: 4px;
    border-top-right-radius: 16px;
    border-bottom-right-radius: 16px;
    border-bottom-left-radius: 16px;
}
QLabel#ChatAssistantBubbleGrouped {
    border-radius: 16px;
}
QLabel#ChatTypingBubble {
    color: #C7B9D4;
    padding: 8px 14px;
    font-size: 11px;
}

QLabel#ChatAvatar {
    background-color: #B39CDB;
    color: #1E1626;
    border-radius: 14px;
    font-size: 13px;
    font-weight: bold;
}

QLabel#ChatTimestamp,
QLabel#ChatDateLabel {
    color: #9C8EA9;
    padding: 0 6px;
}
QLabel#ChatTimestamp { font-size: 10px; }
QLabel#ChatDateLabel { font-size: 11px; font-weight: 600; }

QFrame#ChatDateRule {
    color: #4A3A54;
}

QDialog#ChatHistoryDialog,
QListWidget#ChatHistoryList {
    background-color: #2E2238;
    color: #EDE6F2;
}
QListWidget#ChatHistoryList {
    border: 1px solid #4A3A54;
    selection-background-color: #B39CDB;
    selection-color: #1E1626;
}
QLabel#ChatHistoryEmpty {
    color: #C7B9D4;
}

/* ── Opportunity source badges ───────────────────────────────── */
QLabel#EventSourceMoxie {
    background-color: #2D1A3E;
    color: #F5F0EE;
    border-radius: 9px;
    padding: 3px 10px;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.5px;
}
QLabel#EventSourceExternal {
    background-color: transparent;
    color: #8C8C8C;
    border: 1px solid #8C8C8C;
    border-radius: 9px;
    padding: 2px 9px;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.5px;
}

/* ── Full-width "Open Details" button on event cards ─────────── */
/* CHANGED: opaque accent fill instead of transparent (per request) */
QPushButton#EventDetailsBtn {
    background-color: #7B8BE0;
    color: #1E1626;
    border: 1px solid #7B8BE0;
    border-radius: 8px;
    padding: 8px 12px;
    font-size: 12px;
    font-weight: 600;
}
QPushButton#EventDetailsBtn:hover {
    background-color: #93A2F0;
    border-color: #93A2F0;
}
QPushButton#EventDetailsBtn:pressed {
    background-color: #B39CDB;
    border-color: #B39CDB;
}
QPushButton#EventDetailsBtn:focus {
    border: 2px solid #EDE6F2;
    padding: 7px 11px;
}

/* ── Bookmark button on event cards (new) ───────────────────── */
QPushButton#EventBookmarkBtn {
    background-color: #251A2E;
    color: #9C8EA9;
    border: 1px solid #4A3A54;
    border-radius: 8px;
    font-size: 18px;
    padding: 0;
    min-width: 34px;
    min-height: 34px;
}
QPushButton#EventBookmarkBtn:hover {
    color: #7B8BE0;
    border-color: #7B8BE0;
}
QPushButton#EventBookmarkBtn:focus {
    border: 2px solid #7B8BE0;
}
QPushButton#EventBookmarkBtnOn {
    background-color: #7B8BE0;
    color: #1E1626;
    border: 1px solid #7B8BE0;
    border-radius: 8px;
    font-size: 18px;
    padding: 0;
    min-width: 34px;
    min-height: 34px;
}
QPushButton#EventBookmarkBtnOn:hover {
    background-color: #93A2F0;
}

/* ── Standard back button used on every sub-page ────────────── */
QPushButton#BackBtn {
    background-color: #2D1A3E;
    border: 1px solid rgba(127, 127, 127, 90);
    border-radius: 8px;
    padding: 6px 14px;
    font-size: 13px;
    font-weight: 600;
    color: #F5F0EE;
}
QPushButton#BackBtn:hover {
    background-color: rgba(127, 127, 127, 30);
    border-color: rgba(127, 127, 127, 160);
}
QPushButton#BackBtn:pressed {
    background-color: rgba(127, 127, 127, 60);
}

/* ── Mission hero typography (old hero section) ──────────────── */
QLabel#HeroMissionTitle {
    font-size: 84px;
    font-weight: 900;
    letter-spacing: -2px;
    color: #2D1A3E;
}
QLabel#HeroMissionBodyLg {
    font-size: 34px;
    font-weight: 400;
    color: #2D1A3E;
}
QLabel#HeroMissionBodyMd {
    font-size: 22px;
    font-weight: 400;
    color: #2D1A3E;
}
QLabel#HeroMissionBodySm {
    font-size: 18px;
    font-weight: 700;
    color: #2D1A3E;
}

/* ── Learn More button ──────────────────────────────────────── */
QPushButton#HeroLearnBtn {
    border: none;
    border-radius: 8px;
    font-size: 15px;
    font-weight: 700;
    background-color: #CBB9B4;
    color: #1A1A1A;
}
QPushButton#HeroLearnBtn:hover {
    background-color: #8C8C8C;
}
QPushButton#HeroLearnBtn:pressed {
    background-color: #F5F0EE;
}

/* ==========================================================================
   HERO — editorial split-panel (new layout)
   ========================================================================== */
#HeroSection    { background-color: #1E1626; }
#HeroLeftPanel  { background-color: #2A1F33; }
#HeroRightPanel { background-color: #1E1626; }
#HeroBottomBar  { background-color: #B39CDB; }
#HeroWordmark   { padding: 0; margin: 0; }

#HeroHeadline {
    font-family: "Playfair Display", "Georgia", "Times New Roman", serif;
    font-size: 44px;
    font-weight: 700;
    color: #EDE6F2;
    line-height: 1.15em;
}
#HeroSub {
    font-size: 15px;
    color: #C7B9D4;
    line-height: 1.55em;
}
#HeroPhoto {
    background-color: #2E2238;
    border: none;
}

/* ==========================================================================
   VOLUNTEER MATCH PAGE (new)
   ========================================================================== */
#MatchPage {
    background-color: #1E1626;
    border: none;
}
#MatchCard {
    background-color: #2E2238;
    border: 1px solid #4A3A54;
    border-top: 4px solid #7B8BE0;
    border-radius: 0px;
}
#MatchStepTitle {
    font-family: "Playfair Display", "Georgia", "Times New Roman", serif;
    font-size: 22px;
    font-weight: bold;
    color: #EDE6F2;
}
#MatchChip {
    background-color: #251A2E;
    color: #EDE6F2;
    border: 1px solid #4A3A54;
    padding: 10px 16px;
    font-size: 13px;
    border-radius: 0px;
    text-align: left;
}
#MatchChip:hover {
    border-color: #7B8BE0;
}
#MatchChip:checked,
#MatchChipChecked {
    background-color: #B39CDB;
    color: #1E1626;
    border: 1px solid #B39CDB;
}

/* ==========================================================================
   CAREER CLUSTER MULTI-SELECT (new)
   ========================================================================== */
#ClusterMultiSelect {
    background-color: transparent;
    border: none;
}
#ClusterChip {
    background-color: #251A2E;
    color: #EDE6F2;
    border: 1px solid #4A3A54;
    padding: 8px 14px;
    font-size: 12px;
    border-radius: 0px;
    text-align: left;
}
#ClusterChip:hover {
    border-color: #7B8BE0;
}
#ClusterChip:checked,
#ClusterChipChecked {
    background-color: #B39CDB;
    color: #1E1626;
    border: 1px solid #B39CDB;
}

/* ==========================================================================
   QR / TIME-GATED EVENT VIEW (new)
   ========================================================================== */
#EventQrDialog {
    background-color: #2E2238;
    border: 1px solid #4A3A54;
    border-top: 4px solid #7B8BE0;
}
#EventQrImage {
    background-color: #2E2238;
    border: 1px solid #4A3A54;
}
#EventQrStatus {
    font-size: 14px;
    font-weight: bold;
    color: #EDE6F2;
}
#EventQrWindow {
    font-size: 12px;
    color: #9C8EA9;
}

/* ==========================================================================
   EXPORT DIALOG (new)
   ========================================================================== */
#ExportDialog {
    background-color: #2E2238;
    border: 1px solid #4A3A54;
    border-top: 4px solid #7B8BE0;
}
#ExportSection {
    background-color: #2E2238;
    border: 1px solid #4A3A54;
}
#ExportFormatRow {
    background-color: transparent;
    border: none;
}
/* ==========================================================================
   ORG DASHBOARD — cards, tables, alerts, recommendations
   ========================================================================== */

#OrgStatTile {
    background-color: #2E2238;
    border: 1px solid #4A3A54;
    border-radius: 0px;
}
#OrgStatValue {
    font-size: 32px;
    font-weight: 700;
    color: #B39CDB;
}
#OrgStatCaption {
    font-size: 12px;
    color: #C7B9D4;
}

#OrgRowMain {
    font-size: 14px;
    color: #EDE6F2;
    font-weight: 600;
}
#OrgRowSub {
    font-size: 12px;
    color: #9C8EA9;
}

#OrgCardLink {
    background: transparent;
    border: none;
    color: #7B8BE0;
    font-size: 12px;
    font-weight: 700;
    padding: 4px 8px;
}
#OrgCardLink:hover {
    color: #93A2F0;
    text-decoration: underline;
}

#OrgOppList {
    background-color: #2E2238;
    border: 1px solid #4A3A54;
    outline: none;
    font-size: 13px;
    color: #EDE6F2;
}
#OrgOppList::item {
    padding: 12px 14px;
    border-bottom: 1px solid #4A3A54;
}
#OrgOppList::item:hover {
    background-color: rgba(123, 139, 224, 25);
}
#OrgOppList::item:selected {
    background-color: #B39CDB;
    color: #1E1626;
}

#OrgRecBlock {
    background-color: #2E2238;
    border: 1px solid #4A3A54;
    border-top: 4px solid #7B8BE0;
}
#OrgRecDivider {
    background-color: #4A3A54;
    border: none;
}
#OrgRecTableHeader {
    background-color: #251A2E;
}
#OrgRecColLabel {
    color: #9C8EA9;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.6px;
    text-transform: uppercase;
}
#OrgRecRow {
    background-color: #251A2E;
    border: 1px solid #4A3A54;
}
#OrgRecRow:hover {
    border-color: #7B8BE0;
}
#OrgRecAvatar {
    background-color: #7B8BE0;
    color: #1E1626;
    border-radius: 19px;
    font-size: 14px;
    font-weight: 700;
}
#OrgRecName {
    font-size: 14px;
    font-weight: 700;
    color: #EDE6F2;
}
#OrgRecSub {
    font-size: 12px;
    color: #9C8EA9;
}
#OrgRecScore {
    background-color: #7B8BE0;
    color: #1E1626;
    font-size: 12px;
    font-weight: 700;
    border-radius: 12px;
    padding: 4px 10px;
}
#OrgRecReason {
    font-size: 12px;
    color: #C7B9D4;
}

/* ==========================================================================
   NOTIFICATIONS — social-media style feed
   ========================================================================== */
#NotifCard {
    background-color: #2E2238;
    border: 1px solid #4A3A54;
    border-left: 4px solid #7B8BE0;
    border-radius: 8px;
    margin: 2px 0;
}
#NotifCard:hover {
    border-color: #7B8BE0;
}
#NotifAvatar {
    background-color: #7B8BE0;
    color: #1E1626;
    border-radius: 19px;
    font-size: 14px;
    font-weight: 700;
}
#NotifName {
    font-size: 14px;
    font-weight: 700;
    color: #EDE6F2;
}
#NotifSubject {
    font-size: 14px;
    font-weight: 700;
    color: #EDE6F2;
    padding-top: 2px;
}
#NotifTimestamp {
    font-size: 11px;
    color: #9C8EA9;
}
#NotifTypeChip {
    background-color: #B39CDB;
    color: #1E1626;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.4px;
    padding: 3px 9px;
    border-radius: 9px;
}
#NotifBody {
    font-size: 13px;
    color: #EDE6F2;
    padding-left: 50px;
}
#NotifDayHeader {
    font-size: 11px;
    font-weight: 700;
    color: #C7B9D4;
    padding: 10px 2px 2px 2px;
    letter-spacing: 1px;
}
/* ==========================================================================
   MOXIE DASHBOARD — KPI tiles, chart cards, section labels
   ========================================================================== */
#MoxieKpiTile {
    background-color: #2E2238;
    border: 1px solid #4A3A54;
    border-top: 3px solid #7B8BE0;
    border-radius: 0px;
}
#MoxieKpiTile:hover {
    border-top: 3px solid #B39CDB;
}
#MoxieKpiValue {
    font-family: "Playfair Display", "Georgia", "Times New Roman", serif;
    font-size: 34px;
    font-weight: 900;
    color: #B39CDB;
    letter-spacing: -1px;
}
#MoxieKpiCaption {
    font-size: 11px;
    font-weight: 700;
    color: #9C8EA9;
    text-transform: uppercase;
    letter-spacing: 1px;
}
#MoxieKpiDelta {
    font-size: 12px;
    font-weight: 700;
    padding: 3px 8px;
    border-radius: 10px;
    color: #9C8EA9;
    background-color: #251A2E;
}
#MoxieKpiDelta[trend="up"]   { color: #1E1626; background-color: #7B8BE0; }
#MoxieKpiDelta[trend="down"] { color: #F5F0EE; background-color: #E74C3C; }
#MoxieKpiDelta[trend="flat"] { color: #9C8EA9; background-color: #251A2E; }

#MoxieSectionLabel {
    font-size: 11px;
    font-weight: 800;
    color: #9C8EA9;
    letter-spacing: 1.6px;
    text-transform: uppercase;
    padding: 4px 0 2px 0;
}
#MoxieSectionTitle {
    font-family: "Playfair Display", "Georgia", "Times New Roman", serif;
    font-size: 20px;
    font-weight: 700;
    color: #EDE6F2;
    padding: 0;
}

#MoxieHeroTitle {
    font-family: "Playfair Display", "Georgia", "Times New Roman", serif;
    font-size: 40px;
    font-weight: 900;
    color: #B39CDB;
    letter-spacing: -0.5px;
}
#MoxieHeroSub {
    font-size: 15px;
    color: #9C8EA9;
    padding-bottom: 4px;
}

#MoxieChartCard {
    background-color: #2E2238;
    border: 1px solid #4A3A54;
    border-radius: 0px;
}
#MoxieChartCardDarkAccent {
    background-color: #2E2238;
    border: 1px solid #4A3A54;
    border-top: 4px solid #B39CDB;
}
#MoxieChartCardBlueAccent {
    background-color: #2E2238;
    border: 1px solid #4A3A54;
    border-top: 4px solid #7B8BE0;
}

#MoxieHeroAction {
    background-color: #B39CDB;
    color: #1E1626;
    font-size: 13px;
    font-weight: 700;
    padding: 12px 22px;
    border: none;
    border-radius: 0px;
}
#MoxieHeroAction:hover { background-color: #7B8BE0; }
#MoxieHeroActionSecondary {
    background-color: transparent;
    color: #B39CDB;
    border: 1px solid #4A3A54;
    font-size: 13px;
    font-weight: 700;
    padding: 12px 22px;
    border-radius: 0px;
}
#MoxieHeroActionSecondary:hover {
    border-color: #7B8BE0;
    color: #7B8BE0;
}